{"pageProps":{"careerData":{"id":"aVfcKBAAABH96R5z","uid":null,"url":"/career","type":"career","href":"https://icomat.cdn.prismic.io/api/v2/documents/search?ref=aqEWxBEAACwAh40-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aVfcKBAAABH96R5z%22%29+%5D%5D","tags":[],"first_publication_date":"2026-01-02T14:59:06+0000","last_publication_date":"2026-02-15T10:24:07+0000","slugs":["career"],"linked_documents":[],"lang":"en-us","alternate_languages":[],"data":{"hero_title_main":"Build what the world \nhasn’t seen before.","hero_image":{"dimensions":{"width":5760,"height":3732},"alt":null,"copyright":null,"url":"https://images.prismic.io/icomat/aWflSwIvOtkhBgz2_career-hero.png?auto=format,compress","id":"aWflSwIvOtkhBgz2","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"hero_text_mode":"white","heading_text":"At ICOMAT, you’ll work alongside engineers, researchers, and operators who care deeply about doing things the right way. Our entire team pushes the edge of what’s possible in composites, because in the industries we support, precision, quality, and innovation are not optional.","two_column_text_1_title":"A career shaped \nby purpose.","two_column_text_1_text":[{"type":"paragraph","text":"We work in environments where every gram, every millimetre, and every decision matters. The problems we solve require curiosity, patience, and rigor.\n\nWe collaborate closely, communicate clearly, and take ownership of the work we deliver. It’s not about speed for its own sake, it’s about getting it right as a team.\n\nIf you're motivated by meaningful technical challenges and real impact, there's a place for you here.","spans":[{"start":0,"end":149,"type":"strong"}],"direction":"ltr"}],"image_side_image_1":{"dimensions":{"width":1380,"height":794},"alt":null,"copyright":null,"url":"https://images.prismic.io/icomat/aVfd9nNYClf9ovIc_career-1.png?auto=format,compress","id":"aVfd9nNYClf9ovIc","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"image_side_image_2":{"dimensions":{"width":8192,"height":5464},"alt":null,"copyright":null,"url":"https://images.prismic.io/icomat/aYNJut0YXLCxVXKJ_icomat.gloucester.2025.09-1668.fullresolution.jpg?auto=format,compress","id":"aYNJut0YXLCxVXKJ","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"job_section_title":"Current job openings","job_section_link":{"link_type":"Web","key":"e28b1b08-00b5-4c5d-bc28-631f1f854f3e","url":"https://careers.icomat.co.uk/jobs","text":"See all jobs"},"two_column_text_2_title":"Workplace & Culture","two_column_text_2_text":[{"type":"paragraph","text":"At ICOMAT, the work is demanding, and that’s the point. We build systems and parts that must perform in the real world, where precision and reliability matter.   \n\nThere are no passengers here. Everyone contributes, and everyone is accountable.","spans":[],"direction":"ltr"}],"image_side_text_2":[{"type":"paragraph","text":"We solve hard problems together, because hard problems require more than one perspective. We question assumptions, build with precision, and take full responsibility for what leaves our hands.","spans":[],"direction":"ltr"}],"image_side_image_2_1":{"dimensions":{"width":1380,"height":1380},"alt":null,"copyright":null,"url":"https://images.prismic.io/icomat/aVfgiHNYClf9ovI5_career-3.png?auto=format,compress","id":"aVfgiHNYClf9ovI5","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"image_side_image_2_2":{"dimensions":{"width":1380,"height":1380},"alt":null,"copyright":null,"url":"https://images.prismic.io/icomat/aVfg63NYClf9ovI__career-4.png?auto=format,compress","id":"aVfg63NYClf9ovI_","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"center_heading_text":"We take full responsibility \nfor what leaves our hands.","about_section_title":"About ICOMAT","about_section_text":[{"type":"paragraph","text":"ICOMAT is an Advanced Manufacturing business, which provides state-of-the-art lightweighting solutions based on the Rapid Tow Shearing (RTS) process.\n\nWe are proud to collaborate with the world’s top OEMs and end-users. Together we develop new frontiers in automated composites manufacturing which revolutionizes the aerospace, automotive and space sectors.","spans":[{"start":0,"end":150,"type":"strong"}],"direction":"ltr"}],"about_numbers_items":[{"label":"FOUNDED IN","number":"2019"},{"label":"Co-workers","number":"75+"}],"about_cta_link":{"id":"aTg5thAAACIAuipV","type":"about","tags":[],"lang":"en-us","slug":"about","first_publication_date":"2025-12-09T15:01:57+0000","last_publication_date":"2026-02-16T19:51:48+0000","url":"/manifesto","link_type":"Document","key":"51d90c54-c423-471d-8dbe-4d86f7f155a6","isBroken":false,"text":"READ OUR MANIFESTO"},"hot_links":[{"image":{"dimensions":{"width":690,"height":424},"alt":"Industries","copyright":null,"url":"https://images.prismic.io/icomat/aTlcNXNYClf9oAoe_hot-links2.png?auto=format,compress","id":"aTlcNXNYClf9oAoe","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"link":{"id":"aTqPyhAAACEAvff0","type":"industries","tags":[],"lang":"en-us","slug":"industries","first_publication_date":"2025-12-11T09:33:15+0000","last_publication_date":"2026-02-16T18:08:48+0000","url":"/industries","link_type":"Document","key":"cc1c646a-847c-49c5-ba27-2621de4b886f","isBroken":false,"text":"Industries"}},{"image":{"dimensions":{"width":1380,"height":847},"alt":"company","copyright":null,"url":"https://images.prismic.io/icomat/aVeeiHNYClf9ousv_hot-links-company.png?auto=format,compress","id":"aVeeiHNYClf9ousv","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"link":{"id":"aTg5thAAACIAuipV","type":"about","tags":[],"lang":"en-us","slug":"about","first_publication_date":"2025-12-09T15:01:57+0000","last_publication_date":"2026-02-16T19:51:48+0000","url":"/manifesto","link_type":"Document","key":"f860d75c-e228-45af-b0cd-3d2936c310eb","isBroken":false,"text":"Manifesto"}}],"meta_title":"ICOMAT - Careers","meta_description":"Transformational lightweighting solutions. We design and produce the world's light