{"pageProps":{"homeData":{"id":"aSirphIAACUApgr0","uid":null,"url":"/","type":"home","href":"https://icomat.cdn.prismic.io/api/v2/documents/search?ref=aqEWxBEAACwAh40-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aSirphIAACUApgr0%22%29+%5D%5D","tags":[],"first_publication_date":"2025-11-27T19:51:33+0000","last_publication_date":"2026-03-09T08:37:02+0000","slugs":["home"],"linked_documents":[],"lang":"en-us","alternate_languages":[],"data":{"hero_title_main":"Engineer \nWithout Limits","hero_text":[{"type":"paragraph","text":"The only composite manufacturer in the world delivering steered fiber composites at scale. Unlocking design and performance never thought possible.","spans":[{"start":91,"end":147,"type":"strong"}],"direction":"ltr"}],"hero_video_desktop":{"link_type":"Media","key":"d3029027-7f1b-4038-8042-9ea04c73f31c","kind":"file","id":"aWZQUwIvOtkhBcXM","url":"https://icomat.cdn.prismic.io/icomat/aWZQUwIvOtkhBcXM_ICOMAT-HOMEPAGE_1.mp4","name":"hero-home.mp4","size":"2748103"},"hero_video_mobile":{"link_type":"Media","key":"422a5ae5-7ea1-48d7-8c69-3921d8f2b54d","kind":"file","id":"aY2WZ90YXLCxVtnD","url":"https://icomat.cdn.prismic.io/icomat/aY2WZ90YXLCxVtnD_hero-mobile-2.mp4","name":"hero-home-mobile-2.mp4","size":"1077925"},"hero_poster":{"dimensions":{"width":2560,"height":1440},"alt":null,"copyright":null,"url":"https://images.prismic.io/icomat/aWER2AIvOtkhBOig_ICOMAT-HOMEBACKGROUNDVIDEO2.webp?auto=format,compress","id":"aWER2AIvOtkhBOig","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"hero_text_mode":"white","heading_rts_text":"ICOMAT invented RTS. \nRapid Tow Shearing.","composite_dual_title":"The RTS Revolution","composite_dual_description":"For 50 years, composites were limited to straight lines. Our patented RTS process removes that constraint. Fibers can now flow along curves to build lighter, stronger, more efficient parts.","composite_dual_link":{"id":"aUEuzBAAACIAx9KG","type":"tech","tags":[],"lang":"en-us","slug":"tech","first_publication_date":"2025-12-16T10:08:53+0000","last_publication_date":"2026-02-16T08:11:57+0000","url":"/tech","link_type":"Document","key":"186cce95-3d3e-4d04-9b16-4371f14e310f","isBroken":false,"text":"Explore our technology"},"composite_dual_composites":[{"title":"Conventional / straight Fiber Composites","description":null,"dialog_title":"Before RTS","dialog_description":[{"type":"paragraph","text":"Composite materials are only strong in the fiber direction. Traditional manufacturing relies on straight fiber layers, but real-world forces and structures don’t follow straight lines. This means more material, more weight, and higher cost than necessary.\n\nICOMAT's Rapid Tow Shearing (RTS) process changes that: it steers the fibers aligning them with the structure's load path. This is the natural, most efficient way to use composites.","spans":[{"start":0,"end":255,"type":"strong"}],"direction":"ltr"}],"dialog_link":{"id":"aUEuzBAAACIAx9KG","type":"tech","tags":[],"lang":"en-us","slug":"tech","first_publication_date":"2025-12-16T10:08:53+0000","last_publication_date":"2026-02-16T08:11:57+0000","url":"/tech","link_type":"Document","key":"a53ab5ac-7a4e-4614-a4e3-e3b889b320b2","isBroken":false,"text":"Technology"},"dialog_image":{"dimensions":{"width":620,"height":407},"alt":" before rts","copyright":null,"url":"https://images.prismic.io/icomat/aSmCfHNYClf9nkeJ_Container.png?auto=format,compress","id":"aSmCfHNYClf9nkeJ","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}}},{"title":"RTS / Steered Fiber Composites","description":"Up to 65% lighter, \n10x faster production","dialog_title":"RTS Design","dialog_description":[{"type":"paragraph","text":"With Rapid Tow Shearing (RTS), each fiber is precisely steered to follow the load path of the structure and not limited to fixed 0°, ±45°, or 90° angles.\n\nThis freedom of orientation allows engineers to design lighter, stronger, and more efficient parts, where every fiber contributes to performance.\nForm and function become one continuous flow.","spans":[{"start":0,"end":153,"type":"strong"}],"direction":"ltr"}],"dialog_link":{"id":"aUEuzBAAACIAx9KG","type":"tech","tags":[],"lang":"en-us","slug":"tech","first_publication_date":"2025-12-16T10:08:53+0000","last_publication_date":"2026-02-16T08:11:57+0000","url":"/tech","link_type":"Document","key":"1486f2f9-24d0-4b2a-8245-b226e8e0412e","isBroken":false,"text":"Technology"},"dialog_image":{"dimensions":{"width":413,"height":271},"alt":"RTS Design","copyright":null,"url":"https://images.prismic.io/icomat/aSmCn3NYClf9nkeR_Container2.png?auto=format,compress","id":"aSmCn3NYClf9nkeR","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}}}],"large_composite_dialogs":[{"title":"At scale","description":[{"type":"paragraph","text":"RTS brings fiber steering to manufacturing scale. Each layer is deposited and steered in real time, enabling large, complex composite structures, such as fuselage frames or wing skins, to be produced at industrial volumes.\n\nBy combining precision with automation, ICOMAT delivers consistent, repeatable quality across every part, bridging the gap between advanced composites and true mass production.","spans":[{"start":0,"end":222,"type":"strong"}],"direction":"ltr"}],"link":{"id":"aUEuzBAAACIAx9KG","type":"tech","tags":[],"lang":"en-us","slug":"tech","first_publication_date":"2025-12-16T10:08:53+0000","last_publication_date":"2026-02-16T08:11:57+0000","url":"/tech","link_type":"Document","key":"63f2699d-7c11-4737-bab3-d19c8a549ed4","isBroken":false,"text":"Technology"},"image":{"dimensions":{"width":826,"height":542},"alt":"At scale","copyright":null,"url":"https://images.prismic.io/icomat/aSmPKXNYClf9nksT_Containerscale2.png?auto=format,compress","id":"aSmPKXNYClf9nksT","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}}},{"title":"Zero defects","description":[{"type":"paragraph","text":"ICOMAT’s RTS process eliminates the common defects found in traditional composite manufacturing. No wrinkles, no gaps, no distortions. \n\nEach layer is steered and deposited with complete precision, ensuring consistent fiber alignment and optimal structural integrity.\n\nThe result: components that meet aerospace-grade tolerances from the very first part.  Lighter, stronger, and defect-free.","spans":[{"start":0,"end":135,"type":"strong"}],"direction":"ltr"}],"link":{"id":"aUEuzBAAACIAx9KG","type":"tech","tags":[],"lang":"en-us","slug":"tech","first_publication_date":"2025-12-16T10:08:53+0000","last_publication_date":"2026-02-16T08:11:57+0000","url":"/tech","link_type":"Document","key":"3a7c6c80-779b-4e8e-a613-3b7942a237a9","isBroken":false,"text":"Technology"},"image":{"dimensions":{"width":826,"height":542},"alt":"Zero defects","copyright":null,"url":"https://images.prismic.io/icomat/aSmPXnNYClf9nks4_zero2.png?auto=format,compress","id":"aSmPXnNYClf9nks4","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}}},{"title":"10× faster","description":[{"type":"paragraph","text":"RTS eliminates slow, manual lay-ups by automating tape steering and forming in one continuous process. Preforms are created in minutes and shaped into final parts in hours. Up to 10x faster than conventional composite manufacturing.\n\nThis leap in speed allows engineers to iterate quickly, scale production efficiently, and bring high-performance composite structures to market faster than ever before.","spans":[{"start":0,"end":232,"type":"strong"}],"direction":"ltr"}],"link":{"id":"aUEuzBAAACIAx9KG","type":"tech","tags":[],"lang":"en-us","slug":"tech","first_publication_date":"2025-12-16T10:08:53+0000","last_publication_date":"2026-02-16T08:11:57+0000","url":"/tech","link_type":"Document","key":"58807fe5-ede6-4186-883d-ec08f9d42902","isBroken":false,"text":"Technology"},"image":{"dimensions":{"width":826,"height":542},"alt":"10× faster","copyright":null,"url":"https://images.prismic.io/icomat/aSmPPHNYClf9nksr_Containerfaster2.png?auto=format,compress","id":"aSmPPHNYClf9nksr","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}}}],"image_side_text":[{"type":"paragraph","text":"How we operate. We build fully integrated factories for composite parts. Using proprietary hardware and software, we automate and control the entire process. From a roll of carbon fiber through a finished, painted, and inspected product, including design and analysis.","spans":[{"start":0,"end":16,"type":"strong"}],"direction":"ltr"}],"image_side_image_1":{"dimensions":{"width":2769,"height":2505},"alt":null,"copyright":null,"url":"https://images.prismic.io/icomat/aYi2xN0YXLCxVlJp_icomat.gloucester.2025.09-1114.full-resolution-2.jpg?auto=format,compress","id":"aYi2xN0YXLCxVlJp","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"image_side_image_2":{"dimensions":{"width":3204,"height":2589},"alt":null,"copyright":null,"url":"https://images.prismic.io/icomat/aYi3Y90YXLCxVlJ0_icomat.gloucester.2025.09-746.full-resolution-3.jpg?auto=format,compress","id":"aYi3Y90YXLCxVlJ0","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"advantage_subtitle":"Our advantage","advantage_title":"Unlocking innovation for all.","advantage_description":[{"type":"paragraph","text":"We built the only fully integrated system in the world that produces steered fiber composites, defect-free and at industrial scale.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Our proprietary hardware, software, and production facilities work as one end-to-end platform.","spans":[],"direction":"ltr"}],"advantage_items":[{"title":"Better products","description":"Steering unlocks unprecedented freedom that delivers the lightest, strongest parts possible."},{"title":"Faster timelines","description":"10x faster production via forming workflows, only possible with steering."},{"title":"Scale-as-you-go","description":"With automation, no defects, no delays, no excuses."}],"heading_production_text":"End-to-end production","timeline_items":[{"image":{"dimensions":{"width":1332,"height":880},"alt":"End-to-End Digital Thread (Structural & Production Optimisation)","copyright":null,"url":"https://images.prismic.io/icomat/aV4sFXNYClf9o2Xr_home-timeline-2.png?auto=format,compress","id":"aV4sFXNYClf9o2Xr","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"text":"End-to-End Digital Thread \n(Structural & Production Optimisation)"},{"image":{"dimensions":{"width":1332,"height":880},"alt":"Material Slitting & Storage","copyright":null,"url":"https://images.prismic.io/icomat/aV4s5XNYClf9o2YF_home-timeline-2.png?auto=format,compress","id":"aV4s5XNYClf9o2YF","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"text":"Material Slitting & Storage"},{"image":{"dimensions":{"width":1332,"height":880},"alt":"Tooling Production (Metallic, Composite)","copyright":null,"url":"https://images.prismic.io/icomat/aV4s7nNYClf9o2YH_home-timeline-3.png?auto=format,compress","id":"aV4s7nNYClf9o2YH","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"text":"Tooling Production (Metallic, Composite)"},{"image":{"dimensions":{"width":1332,"height":880},"alt":null,"copyright":null,"url":"https://images.prismic.io/icomat/aZM6xlWLo0XkEjDp_Untitled-1.jpg?auto=format,compress","id":"aZM6xlWLo0XkEjDp","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"text":"Most Advanced Tape Laying Capability in the World"},{"image":{"dimensions":{"width":1332,"height":880},"alt":"Curing (Autoclaves, Presses, Hot Drape Forming)","copyright":null,"url":"https://images.prismic.io/icomat/aV4s_nNYClf9o2YR_home-timeline-5.png?auto=format,compress","id":"aV4s_nNYClf9o2YR","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"text":"Curing (Autoclaves, Presses, Hot Drape Forming)"},{"image":{"dimensions":{"width":3710,"height":2475},"alt":"Inspection","copyright":null,"url":"https://images.prismic.io/icomat/aXt4aQIvOtkhCFBx_Picture18.png?auto=format,compress","id":"aXt4aQIvOtkhCFBx","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"text":"Inspection"},{"image":{"dimensions":{"width":1332,"height":880},"alt":"Painting","copyright":null,"url":"https://images.prismic.io/icomat/aV4tB3NYClf9o2YT_home-timeline-6.png?auto=format,compress","id":"aV4tB3NYClf9o2YT","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"text":"Painting"}],"accordion_title":"Our customers have no margin for error.","accordion_section_title":"Trusted by industry leaders","accordion_items":[{"logo":{"dimensions":{"width":78,"height":48},"alt":"Jobby logo","copyright":null,"url":"https://images.prismic.io/icomat/aVFZ23NYClf9oqbg_f48a5d32-6963-4b34-93e0-f9bcf5d41c69.png?auto=format,compress","id":"aVFZ23NYClf9oqbg","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"text":"\"I believe that ICOMAT has unlocked the full potential of composites. Thanks to their unique Rapid Tow Shearing manufacturing process, Engineers can now design and produce composite structures with unparalleled fiber optimization.\"","signature":"John Geriguis, AD @Joby Aviation"},{"logo":{"dimensions":{"width":218,"height":20},"alt":"BAE System logo","copyright":null,"url":"https://images.prismic.io/icomat/aVFaI3NYClf9oqbl_Isolation_Mode.png?auto=format,compress","id":"aVFaI3NYClf9oqbl","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"text":"\"Delivering cost effective and innovative solutions across our manufacturing operations is critical to maintaining a leading position in the UK combat air sector. Working alongside organisations like iCOMAT, and drawing upon their expertise in RTS helps us to ensure we’re able to maintain that edge for our customers.”","signature":"Paul, Head of Airframe Technology @BAE Systems"},{"logo":{"dimensions":{"width":138,"height":40},"alt":"Niar logo","copyright":null,"url":"https://images.prismic.io/icomat/aVFaDHNYClf9oqbj_Untitled-11.png?auto=format,compress","id":"aVFaDHNYClf9oqbj","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"text":"“At NIAR, we work with some of the most advanced manufacturing technologies in the world, and iCOMAT stands out as a true innovator. Their novel approach to composite manufacturing represents a significant leap forward in performance and design flexibility. We've been impressed not only by the capabilities of their technology, but also by the engineering depth and collaborative spirit of their team. iCOMAT is redefining what's possible in composites manufacturing.”","signature":"Waruna Seneviratne, Director  @NIAR"},{"logo":{"dimensions":{"width":238,"height":42},"alt":null,"copyright":null,"url":"https://images.prismic.io/icomat/aZW3KFWLo0XkEoW5_logo-pall.png?auto=format,compress","id":"aZW3KFWLo0XkEoW5","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"text":"\"Impressed with ICOMAT’s first production delivery: quality parts, reliable timelines, and responsive support. A great start to our partnership.\"","signature":"Craig Eason, Supplier Relationship Manager @Pall Aerospace"}],"video_short_video_desktop":{"link_type":"Media","key":"08683fc3-ff33-49e1-bce0-da8ff0ae5d90","kind":"file","id":"aTWkSXNYClf9n4_A","url":"https://icomat.cdn.prismic.io/icomat/aTWkSXNYClf9n4_A_ICOMAT-HOMEBACKGROUNDVIDEO2_1.mp4","name":"ICOMAT - HOME BACKGROUND VIDEO 2_1.mp4","size":"2900333"},"video_short_video_mobile":{"link_type":"Media","key":"75185939-e92a-47a2-a8db-8d33d3d34c90","kind":"file","id":"aTBFPXNYClf9nxRu","url":"https://icomat.cdn.prismic.io/icomat/aTBFPXNYClf9nxRu_hero-mobile.mp4","name":"hero-mobile.mp4","size":"1447475"},"video_thumbnail_image":{"dimensions":{"width":672,"height":406},"alt":null,"copyright":null,"url":"https://images.prismic.io/icomat/aS3WQnNYClf9npx4_icomat.gloucester.2025.09-758.previews2.png?auto=format,compress","id":"aS3WQnNYClf9npx4","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"video_name":"Engineer without limits","business_subtitle":"Business model","business_title":"We don't sell machines.\nWe unlock a new way to build.","business_description":[{"type":"paragraph","text":"ICOMAT eliminates compromise in composites production.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"We provide an end-to-end solution from structural design to finished composite parts.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Our proprietary system unites design software, materials engineering, and automated production into one integrated process.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"It is tailored to the needs of each customer. We can supply preforms or finished parts and can set-up production lines near our clients for high-volume output.","spans":[],"direction":"ltr"}],"business_list_title":"For our clients, this means:","business_list_items":[{"title":"No CapEx.","description":"Scale without upfront investment. We own the system. You receive the output."},{"title":"Fully integrated system.","description":"Software, machines, and production under one roof. No vendors. No handoffs. No risk."},{"title":"Scalable from day one.","description":"Expands from prototype to full scale production, rapidly and without limits."}],"business_others_title":"others","business_comparison_left":[{"text":"Costly, fragmented supply chains"},{"text":"Slow, limited throughput"},{"text":"Unreliable scaling"}],"business_icomat_title":"The Icomat Way","business_comparison_right":[{"text":"Unified production system"},{"text":"Automated high-rate production"},{"text":"Scalable from day one"}],"highlights_title":"The ICOMAT \nsolution","highlights_items":[{"title":"Automated high-speed production","image":{"dimensions":{"width":1812,"height":1112},"alt":"Automated high-speed production","copyright":null,"url":"https://images.prismic.io/icomat/aV4tv3NYClf9o2Yd_home-feature-1.png?auto=format,compress","id":"aV4tv3NYClf9o2Yd","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}}},{"title":"From design to parts","image":{"dimensions":{"width":1812,"height":1112},"alt":"From design to parts","copyright":null,"url":"https://images.prismic.io/icomat/aV4v0nNYClf9o2Zn_home-feature-2.png?auto=format,compress","id":"aV4v0nNYClf9o2Zn","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}}},{"title":"Tailored to your needs","image":{"dimensions":{"width":1812,"height":1112},"alt":"Tailored to your needs","copyright":null,"url":"https://images.prismic.io/icomat/aV4tw3NYClf9o2Ye_home-feature-3.png?auto=format,compress","id":"aV4tw3NYClf9o2Ye","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}}}],"carousel_title":"Supporting leading industries: Aeronautics, Defence, Space, Automotive.","carousel_link":{"id":"aTqPyhAAACEAvff0","type":"industries","tags":[],"lang":"en-us","slug":"industries","first_publication_date":"2025-12-11T09:33:15+0000","last_publication_date":"2026-02-16T18:08:48+0000","url":"/industries","link_type":"Document","key":"27f7e59b-f719-4c16-8970-4a785f0dd236","isBroken":false,"text":"Learn more"},"carousel_slides":[{"title":"Defense","image":{"dimensions":{"width":2160,"height":1400},"alt":"Defense","copyright":null,"url":"https://images.prismic.io/icomat/aTao6nNYClf9n6mV_Defense.webp?auto=format,compress","id":"aTao6nNYClf9n6mV","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}}},{"title":"Aeronautics","image":{"dimensions":{"width":2160,"height":1400},"alt":null,"copyright":null,"url":"https://images.prismic.io/icomat/aZM7XFWLo0XkEjD3_Frame1197134277.jpg?auto=format,compress","id":"aZM7XFWLo0XkEjD3","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}}},{"title":"Space","image":{"dimensions":{"width":2160,"height":1400},"alt":"Space","copyright":null,"url":"https://images.prismic.io/icomat/aTao3nNYClf9n6mT_Space.webp?auto=format,compress","id":"aTao3nNYClf9n6mT","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}}},{"title":"Automotive","image":{"dimensions":{"width":2000,"height":1296},"alt":"Automotive","copyright":null,"url":"https://images.prismic.io/icomat/aTao13NYClf9n6mS_Automotive.webp?auto=format,compress","id":"aTao13NYClf9n6mS","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}}}],"building_subtitle":"","building_title":"Building the future humanity deserves.","building_heading":"We're not just transforming engineering. We're expanding what humanity can build.","building_description":[{"type":"paragraph","text":"By removing the constraints of traditional composites, we unlock a new design language for the physical world: one that's lighter, faster, stronger, and radically more efficient.","spans":[]},{"type":"paragraph","text":"ICOMAT enables the structural foundation for the next era of mobility.","spans":[]}],"building_cta":"Build with Icomat","heading_efficient_text":"Unlocking radically more efficient structures.","feature_cards_title":"A new way to Build","feature_cards_subtitle":"What sets ICOMAT apart","feature_cards":[{"title":"Steered composites","description":"The only process that steers fibers freely, unlocking designs no one else can make."},{"title":"Lighter structures","description":"Up to 65% weight savings with equal or higher strength."},{"title":"Zero defects","description":"Perfect parts every time.\nNo compromises."},{"title":"Faster designs","description":"10× faster than traditional methods.\nPreforms in minutes, parts in hours."},{"title":"Integrated partner","description":"From design to production, everything under one roof, one partner instead of many."}],"hot_links":[{"image":{"dimensions":{"width":1380,"height":847},"alt":"About","copyright":null,"url":"https://images.prismic.io/icomat/aSx0rXNYClf9nmoC_hotlink1.png?auto=format,compress","id":"aSx0rXNYClf9nmoC","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"link":{"id":"aTg5thAAACIAuipV","type":"about","tags":[],"lang":"en-us","slug":"about","first_publication_date":"2025-12-09T15:01:57+0000","last_publication_date":"2026-02-16T19:51:48+0000","url":"/manifesto","link_type":"Document","key":"57009bba-b8e6-4fa9-acb5-2b55818e0dcd","isBroken":false,"text":"Manifesto"}},{"image":{"dimensions":{"width":1380,"height":847},"alt":"Industries","copyright":null,"url":"https://images.prismic.io/icomat/aSx0